DATABASE_URL="postgresql://smokefree:change-me@postgres:5432/smokefree?schema=public"

PORT=3000

JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me"
JWT_REFRESH_TTL="30d"

REGISTRATION_TOKEN_SECRET="change-me"
REGISTRATION_TOKEN_TTL="15m"

OTP_TTL_MINUTES=10
OTP_REQUEST_COOLDOWN_SECONDS=60

ADMIN_API_KEY="change-me"

# Public website checkout (mobile opens this URL; site activates sub via API).
SUBSCRIPTION_WEB_URL="https://zerosmoker.ru/subscribe"

# Optional: FCM legacy server key for push. If empty, pushes are logged only.
# FCM_SERVER_KEY=

# Unisender Go — transactional email for OTP. If omitted, codes are logged to console.
# UNISENDER_API_KEY=
# UNISENDER_FROM_EMAIL=noreply@zerosmoker.ru
# UNISENDER_FROM_NAME=ZeroSmoke
# UNISENDER_API_URL=https://goapi.unisender.ru/ru/transactional/api/v1/email/send.json

# Admin panel (Caddy basic auth hash for /staff-console-*)
# ADMIN_PASSWORD_HASH=

# Production Postgres password (deploy/compose.yml)
# POSTGRES_PASSWORD=
